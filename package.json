    "eslint": "^8.46.0",
    "eslint-config-prettier": "^9.1.0",
    "nuxt": "^4.2.0",
    "postcss": "^8.4.32",
    "prettier": "^3.0.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.1.17"
